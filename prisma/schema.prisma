generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Plane{
  id Int @id @default(autoincrement())
  name String @default("null")
  country String @default("-")
  year Int @default(0000)
  img_url String @default("src\\assests\\myPlane.jpg")
}
